#!/bin/bash
# backup-gate: start Time Machine only when the machine's persistence points
# (launch items, login items, cron, shell rc, sudo/pam, helpers, profiles...)
# match an allowlist you approved. Anything else pauses backups until
# `sudo backup-gate approve`, so an infection can't age out the clean backups.
# https://github.com/mermoddity/backup-gate (MIT license)
#
#   backup-gate run        (LaunchDaemon, every 30 min) when a backup is due (MIN_HOURS)
#                          and the screen is unlocked: check, then back up if clean
#   backup-gate run now    same, but ignore MIN_HOURS (manual run)
#   backup-gate approve    (sudo, interactive) review changes and accept them
#   backup-gate inventory  (sudo) refresh the current inventory, no backup
#   backup-gate status     show last backup, problems and pending changes
#   backup-gate version
set -u
umask 022
VERSION=3.1.2
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH LC_ALL=C

SELF=/usr/local/sbin/backup-gate
ETC=/usr/local/etc/backup-gate
CONFIG=$ETC/config
ALLOW=$ETC/allowlist
STATE=/var/db/backup-gate
LOG=/var/log/backup-gate.log
PLIST=/Library/LaunchDaemons/local.backup-gate.plist
LOCK=/var/run/backup-gate.lock

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"; }
die() { echo "backup-gate: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "must run as root: sudo backup-gate $1"; }

# The config is parsed, never sourced, so it can't run code.
cfg() { sed -n "s/^$1=\([A-Za-z0-9._-]*\)\$/\1/p" "$CONFIG" 2>/dev/null | head -n 1; }

hash_file() {
  if [ -f "$1" ]; then shasum -a 256 < "$1" | cut -c1-64
  elif [ -e "$1" ]; then echo NOT-A-FILE
  else echo ABSENT; fi
}
hash_text() { shasum -a 256 | cut -c1-64; }

# Only fixed text and numbers go into the notification. Item names are
# attacker-controlled and are never passed to osascript.
notify() {
  local user uid
  user=$(stat -f %Su /dev/console)
  [ -n "$user" ] && [ "$user" != root ] || return 0
  uid=$(id -u "$user") || return 0
  launchctl asuser "$uid" sudo -u "$user" osascript \
    -e "display notification \"$1\" with title \"Backup gate\" sound name \"Basso\"" >> "$LOG" 2>&1 \
    || log "notification failed (exit $?)"
}

homes() {
  echo /var/root
  dscl . -list /Users UniqueID | while read -r name uid; do
    [ "$uid" -ge 501 ] 2>/dev/null || continue
    dscl . -read "/Users/$name" NFSHomeDirectory | sed 's/^NFSHomeDirectory: //'
  done
}

list_dir() {  # kind dir: one line per entry, with owner:group:mode and hash
  [ -d "$2" ] || return 0
  find "$2" -mindepth 1 -maxdepth 1 | while read -r f; do
    printf '%s\t%s\t%s\t%s\n' "$1" "$f" "$(stat -f '%Su:%Sg:%Lp' "$f")" "$(hash_file "$f")"
  done
}

inventory() {
  local h f d n
  {
    # launchd jobs and startup items, system-wide and per user
    for d in /Library/LaunchAgents /Library/LaunchDaemons /Library/StartupItems; do list_dir launch "$d"; done
    homes | while read -r h; do list_dir launch "$h/Library/LaunchAgents"; done

    # shell startup files and ssh entry points, per user
    homes | while read -r h; do
      for f in .zshenv .zprofile .zshrc .zlogin .zlogout .bash_profile .bash_login .bashrc .profile \
               .ssh/authorized_keys .ssh/config .ssh/environment .ssh/rc; do
        printf 'shell\t%s/%s\t%s\n' "$h" "$f" "$(hash_file "$h/$f")"
      done
    done

    # system config that can run code or grant root
    for f in /etc/zshenv /etc/zprofile /etc/zshrc /etc/zlogin /etc/profile /etc/bashrc /etc/paths \
             /etc/hosts /etc/sudoers /etc/pam.d/sudo /etc/pam.d/sudo_local /etc/crontab /etc/launchd.conf \
             /etc/rc.common /etc/ssh/sshd_config "$SELF" "$CONFIG"; do
      printf 'system\t%s\t%s\n' "$f" "$(hash_file "$f")"
    done
    for d in /etc/paths.d /etc/sudoers.d /etc/ssh/sshd_config.d /var/at/tabs /var/at/jobs \
             /etc/periodic/daily /etc/periodic/weekly /etc/periodic/monthly \
             /Library/PrivilegedHelperTools /Library/Extensions /Library/Security/SecurityAgentPlugins \
             /Library/ScriptingAdditions; do
      list_dir system "$d"
    done

    # login/logout hooks
    for f in /Library/Preferences/com.apple.loginwindow /var/root/Library/Preferences/com.apple.loginwindow; do
      for n in LoginHook LogoutHook; do
        printf 'hook\t%s:%s\t%s\n' "$f" "$n" "$(defaults read "$f" "$n" 2>/dev/null || echo none)"
      done
    done

    # configuration profiles and system extensions (kept as text, so the diff is readable)
    profiles list -all 2>&1 | sed 's/^/cmd\tprofiles\t/'
    systemextensionsctl list 2>&1 | sed 's/^/cmd\tsysext\t/'

    # login items and background items known to macOS (Background Task Management)
    n=$(sfltool dumpbtm 2>/dev/null | awk '
      function flush() { if (id != "" || url != "" || exe != "") { printf "btm\t%s\t%s|%s|%s|%s\n", uid, type, id, url, exe; c++ }
                         type = id = url = exe = "" }
      /^ *Records for UID/ { flush(); uid = $0; sub(/^ *Records for UID */, "", uid); sub(/ *:.*$/, "", uid); next }
      /^ *#[0-9]+:/        { flush(); next }
      { line = $0; sub(/^ +/, "", line) }
      line ~ /^Type:/            { sub(/^Type: */, "", line); type = line }
      line ~ /^Identifier:/      { sub(/^Identifier: */, "", line); id = line }
      line ~ /^URL:/             { sub(/^URL: */, "", line); url = line }
      line ~ /^Executable Path:/ { sub(/^Executable Path: */, "", line); exe = line }
      END { flush(); print c + 0 > "/dev/stderr" }' 2>&1 >&3)
    [ "${n:-0}" -gt 0 ] || printf 'error\tbtm\tsfltool dumpbtm gave no records\n'
  } 3>&1 | sort -u
}

flags() {  # problems that block backups and can't simply be approved
  grep -E 'com\.Apple\.' "$1" | sed 's/^/IMPERSONATES APPLE: /'
  grep -E '^error' "$1" | sed 's/^/INVENTORY ERROR: /'
  awk -F'\t' '$1 == "launch" && $2 ~ /^\/Library\// && $3 !~ /^root:wheel:/ { print "NOT ROOT-OWNED: " $2 }' "$1"
}

writable() {  # group or other write bit set
  local m; m=$(stat -f %Lp "$1")
  case "${m: -2:1}${m: -1}" in *[2367]*) return 0;; esac
  return 1
}

selfcheck() {  # the gate's own files must be root-owned and not writable by others
  local p
  for p in /usr/local /usr/local/sbin "$SELF" "$ETC" "$CONFIG" "$PLIST" "$STATE" "$ALLOW"; do
    if [ ! -e "$p" ]; then
      [ "$p" = "$ALLOW" ] || echo "GATE FILE MISSING: $p"
      continue
    fi
    [ "$(stat -f %Su:%Sg "$p")" = root:wheel ] || echo "GATE FILE NOT root:wheel: $p"
    writable "$p" && echo "GATE FILE WRITABLE BY OTHERS: $p"
  done
}

refresh() {  # write the current inventory and problems to $STATE
  inventory > "$STATE/current.tmp" && mv "$STATE/current.tmp" "$STATE/current"
  { selfcheck; flags "$STATE/current"; } > "$STATE/flags"
}

check_stale() {
  local last hrs max
  last=$(cat "$STATE/last-success" 2>/dev/null || echo 0)
  hrs=$(( ($(date +%s) - last) / 3600 ))
  max=$(cfg STALE_HOURS); max=${max:-48}
  [ "$hrs" -lt "$max" ] || notify "No successful backup for $hrs hours."
}

exclusions() {  # sticky TM exclusions for dependency folders (they reappear often)
  local h
  homes | while read -r h; do
    [ "$h" != /var/root ] && [ -d "$h" ] || continue
    # Library and the privacy-protected folders are skipped (a daemon has no access to them)
    find -x "$h" \( -path "$h/Library" -o -path "$h/Desktop" -o -path "$h/Documents" -o -path "$h/Downloads" \
                    -o -path "$h/Pictures" -o -path "$h/Movies" -o -path "$h/Music" -o -path "$h/.Trash" \) -prune \
         -o \( -name node_modules -o -name .venv \) -type d -prune -print 2>/dev/null |
    while read -r d; do
      tmutil isexcluded "$d" | grep -q '^\[Excluded\]' || tmutil addexclusion "$d"
    done
  done
}

mounted() { diskutil info "$1" 2>/dev/null | grep -q 'Mounted: *Yes'; }

# Time Machine refuses to finish while the screen is locked (BACKUP_FAILED_DEVICE_LOCKED).
# Locked = no user on the console, or the console session reports a locked screen.
screen_locked() {
  local users
  users=$(ioreg -n Root -d1 | grep '"IOConsoleUsers"')
  echo "$users" | grep -q '"kCGSSessionOnConsoleKey"=Yes' || return 0
  echo "$users" | grep -q '"CGSSessionScreenIsLocked"=Yes'
}

# Newest completed backup = newest TM snapshot on the destination volume.
# (tmutil latestbackup returns nothing when run from launchd, so don't use it.)
latest_snapshot() {
  diskutil apfs listSnapshots "$1" 2>/dev/null |
    sed -n 's/.*Name: *com\.apple\.TimeMachine\.\([0-9-]*\)\.backup$/\1/p' | sort | tail -n 1
}

backup_due() {
  local last min
  last=$(cat "$STATE/last-success" 2>/dev/null || echo 0)
  min=$(cfg MIN_HOURS); min=${min:-4}
  [ $(( $(date +%s) - last )) -ge $(( min * 3600 )) ]
}

backup() {
  local dest vol rc before after
  dest=$(cfg DEST_ID); vol=$(cfg DEST_VOLUME)
  [ -n "$dest" ] && [ -n "$vol" ] || { log "config needs DEST_ID and DEST_VOLUME"; exit 1; }
  # tmutil reports success even when the destination is missing, so check it ourselves
  mounted "$vol" || diskutil mount "$vol" >> "$LOG" 2>&1
  if ! mounted "$vol"; then
    log "backup skipped: destination volume $vol not mounted (disk absent or locked)"
    check_stale
    return
  fi
  before=$(latest_snapshot "$vol")
  log "starting backup to $dest"
  tmutil startbackup --block --destination "$dest" >> "$LOG" 2>&1; rc=$?
  after=$(latest_snapshot "$vol")
  # tmutil exits 0 even when the backup fails, so success = a new completed snapshot
  if [ "$rc" -eq 0 ] && { [ -z "$after" ] || [ "$after" = "$before" ]; }; then
    log "tmutil exited $rc but no new completed backup appeared (latest: ${after:-none})"
    screen_locked && log "screen was locked at the end of the run"
    rc=1
  fi
  if [ "$rc" -eq 0 ]; then
    date +%s > "$STATE/last-success"
    log "backup finished ($after)"
    if [ "$(cfg UNMOUNT_AFTER)" = 1 ] && [ -n "$vol" ]; then
      diskutil unmount "$vol" >> "$LOG" 2>&1 || log "unmount failed"
    fi
  else
    log "backup failed (tmutil exit $rc)"
    check_stale
  fi
}

run() {
  need_root run
  mkdir "$LOCK" 2>/dev/null || { log "skipped: another run is in progress"; exit 0; }
  trap 'rmdir "$LOCK"' EXIT
  # Cheap checks first: most runs (every 30 min) stop here without writing anything.
  if [ "${1:-}" != now ] && ! backup_due; then exit 0; fi
  if screen_locked; then
    # log only the first skip in a row, so the log doesn't fill up overnight
    tail -n 1 "$LOG" 2>/dev/null | grep -q 'skipped: screen locked' || log "skipped: screen locked (backup due, will retry)"
    exit 0
  fi
  if tmutil status | grep -q 'Running = 1'; then log "skipped: Time Machine is already running"; exit 0; fi

  refresh
  if [ ! -f "$ALLOW" ]; then
    log "BLOCKED: no approved baseline (run: sudo backup-gate approve)"
    notify "No approved baseline yet. Backups are paused."
    exit 2
  fi
  diff "$ALLOW" "$STATE/current" > "$STATE/pending.diff"
  if [ -s "$STATE/flags" ]; then
    log "BLOCKED: $(wc -l < "$STATE/flags" | tr -d ' ') problem(s), see backup-gate status"
    notify "ALERT: suspicious item or gate tampering. Backups blocked. Run: backup-gate status"
    check_stale
    exit 3
  fi
  if [ -s "$STATE/pending.diff" ]; then
    local n; n=$(count_changes "$ALLOW" "$STATE/current")
    log "BLOCKED: $n change(s) since the last approval"
    notify "$n change(s) since the last approval. Backups paused until: sudo backup-gate approve"
    check_stale
    exit 3
  fi
  rm -f "$STATE/pending.diff"
  exclusions
  backup
}

# ---- readable change list -------------------------------------------------------------
# Inventory text, plist contents and signatures come from files an attacker may control.
# Control characters are stripped before anything reaches the terminal.
clean() { printf '%s' "$1" | tr '\n' ' ' | LC_ALL=C tr -d '\000-\010\013-\037\177'; }

# changes OLD NEW: one record per changed item, "STATUS<US>old line<US>new line",
# most important kinds first. Items are matched by kind + path (or uid + identifier for
# background items), numbered per key so a duplicate can't hide behind an approved entry.
changes() {
  awk -F'\t' '
    function base(  a) {
      if ($1 == "btm") { split($3, a, "|"); return $1 "\t" $2 "\t" a[2] }
      if ($1 == "cmd" || $1 == "error") return $0
      return $1 "\t" $2
    }
    function rank(kind,  r) { r = index("launch btm system shell hook cmd error", kind); return r ? r : 99 }
    function out(st, o, n,  l, f) {
      l = (n != "" ? n : o); split(l, f, "\t")
      printf "%03d %s\037%s\037%s\037%s\n", rank(f[1]), l, st, o, n
    }
    FILENAME == ARGV[1] { b = base(); ov[b, ++oc[b]] = $0; seen[b] = 1; next }
    { b = base(); nv[b, ++nc[b]] = $0; seen[b] = 1 }
    END {
      for (b in seen) {
        # pair identical entries first, so a duplicate shows up as one addition
        split("", om); split("", nm); uo = un = 0
        for (i = 1; i <= oc[b]; i++)
          for (j = 1; j <= nc[b]; j++)
            if (!nm[j] && ov[b, i] == nv[b, j]) { om[i] = nm[j] = 1; break }
        for (i = 1; i <= oc[b]; i++) if (!om[i]) ro[++uo] = ov[b, i]
        for (j = 1; j <= nc[b]; j++) if (!nm[j]) rn[++un] = nv[b, j]
        for (k = 1; k <= uo || k <= un; k++)
          if (k > un) out("REMOVED", ro[k], ""); else if (k > uo) out("ADDED", "", rn[k]); else out("CHANGED", ro[k], rn[k])
      }
    }' "$1" "$2" | sort | cut -d $'\037' -f 2-
}

quote() {  # show an argument the way a shell would need it
  local q="'\\''"
  case "$1" in *[[:space:]\'\"\$\`\\]*) printf "'%s'" "${1//\'/$q}" ;; *) printf '%s' "$1" ;; esac
}

plist_args() {  # ProgramArguments of a launchd plist as one shell-like line
  local i=0 a out=
  while [ "$i" -lt 64 ] && a=$(plutil -extract "ProgramArguments.$i" raw -o - "$1" 2>/dev/null); do
    out="$out${out:+ }$(quote "$a")"; i=$((i + 1))
  done
  printf '%s' "$out"
}

uid_path() {  # Background Task Management writes /Users/<uid>/...: use the real home folder
  local uid rest name home
  case "$1" in /Users/[0-9]*/*) ;; *) printf '%s' "$1"; return ;; esac
  uid=${1#/Users/}; rest=${uid#*/}; uid=${uid%%/*}
  name=$(id -nu "$uid" 2>/dev/null) && home=$(dscl . -read "/Users/$name" NFSHomeDirectory 2>/dev/null | sed 's/^NFSHomeDirectory: //') \
    && [ -n "$home" ] && printf '%s/%s' "$home" "$rest" || printf '%s' "$1"
}

signer() {  # who signed a program or app bundle, in one line
  local out auth
  [ -e "$1" ] || { echo "this program doesn't exist on disk"; return; }
  out=$(codesign -dv --verbose=2 "$1" 2>&1) || { echo "NOT SIGNED"; return; }
  case "$out" in *Signature=adhoc*) echo "ad-hoc signature only (no developer identity)"; return ;; esac
  codesign --verify "$1" 2>/dev/null || { echo "INVALID signature"; return; }
  # Trust the certificate chain, not the certificate's name (a self-signed one can be named anything)
  codesign --verify -R='anchor apple' "$1" 2>/dev/null && { echo "a tool built into macOS: judge this item by the command above"; return; }
  auth=$(clean "$(printf '%s\n' "$out" | sed -n 's/^Authority=//p' | head -n 1)")
  if codesign --verify -R='anchor apple generic' "$1" 2>/dev/null; then echo "signed by ${auth:-an Apple-issued certificate}"
  else echo "signed with an UNTRUSTED certificate (not issued by Apple): ${auth:-no name}"; fi
}

risks() {  # warnings about a program: $1 = path, $2 = signer text
  case "$2" in
    "NOT SIGNED"|ad-hoc*) echo "! no identified developer (normal for Homebrew tools and your own scripts)" ;;
    *UNTRUSTED*)          echo "! the certificate's name proves nothing: Apple didn't issue it" ;;
    INVALID*)             echo "! the program was modified after it was signed" ;;
    *"doesn't exist"*)    echo "! a leftover from an uninstalled app, or something not installed yet" ;;
  esac
  case "${1##*/}" in sh|bash|zsh|dash|ksh|csh|tcsh|python*|perl*|ruby*|node|osascript|curl|wget|nc|open)
    echo "! starts ${1##*/}: what it does depends on the arguments above" ;; esac
  case "$1" in /tmp/*|/private/tmp/*|/var/tmp/*|/private/var/tmp/*|/var/folders/*|/private/var/folders/*|/Users/Shared/*|*/.*)
    echo "! runs from a temporary, shared or hidden folder" ;; esac
}

# describe OLD NEW MODE: print the changes. MODE: full (program, arguments, signer),
# compact (one line + signer, for the first approval) or brief (one line, no file access).
describe() {
  local mode=$3 st old new kind f2 f3 f4 o3 o4 label name btype bid burl bexe who prog args sig l note hidden=0
  local -a d
  local b='' r='' g='' y='' x=''
  [ -t 1 ] && { b=$'\e[1m'; r=$'\e[31m'; g=$'\e[32m'; y=$'\e[33m'; x=$'\e[0m'; }
  while IFS=$'\037' read -r st old new; do
    old=$(clean "$old"); new=$(clean "$new")
    IFS=$'\t' read -r kind f2 f3 f4 <<< "${new:-$old}"
    o3=; o4=; [ -n "$old" ] && IFS=$'\t' read -r _ _ o3 o4 <<< "$old"
    if [ "$mode" = compact ]; then  # first approval: skip the watched files that don't exist
      case "$f3" in ABSENT|none|"There are no configuration profiles installed"|"0 extension(s)") hidden=$((hidden + 1)); continue ;; esac
    fi
    name=$f2; prog=; args=; note=; d=()
    case "$kind" in
      launch)
        name=${f2##*/}; name=${name%.plist}
        case "$f2" in
          /Library/LaunchDaemons/*) label="Launch daemon (runs as root)" ;;
          /Library/LaunchAgents/*)  label="Launch agent (all users)" ;;
          /Library/StartupItems/*)  label="Startup item (runs as root)" ;;
          /var/root/Library/LaunchAgents/*) label="Launch agent (user root)" ;;
          */Library/LaunchAgents/*) who=${f2%%/Library/LaunchAgents/*}; label="Launch agent (user ${who##*/})" ;;
          *) label="Launch item" ;;
        esac
        if [ -n "$new" ] && [ "$mode" = full ]; then
          d+=("file     $f2")
          l=$(stat -f '%SB' -t '%Y-%m-%d %H:%M' "$f2" 2>/dev/null)
          d+=("         ${l:+created $l, }owner ${f3%:*}, mode ${f3##*:}")
          # macOS doesn't record who creates a launch item; an installer receipt is the only trace
          l=$(pkgutil --file-info "$f2" 2>/dev/null | sed -n 's/^pkgid: //p' | head -n 1)
          [ -n "$l" ] && d+=("package  installed by package $(clean "$l")")
        fi
        if [ -n "$new" ] && [ -f "$f2" ]; then
          prog=$(plutil -extract Program raw -o - "$f2" 2>/dev/null || plutil -extract ProgramArguments.0 raw -o - "$f2" 2>/dev/null)
          args=$(plist_args "$f2")
          [ -n "$prog" ] || note="runs     nothing (empty or invalid plist)"
        fi ;;
      btm)
        IFS='|' read -r btype bid burl bexe <<< "$f3"
        btype=${btype% (*}; [[ $bid =~ ^[0-9]+\.(.+)$ ]] && bid=${BASH_REMATCH[1]}
        if [ "$f2" = -2 ]; then who=system; else who=$(id -nu "$f2" 2>/dev/null || echo "uid $f2"); fi
        case "$btype" in
          app) label="Login item ($who)" ;;
          "legacy agent") label="Background agent ($who)" ;;
          "legacy daemon") label="Background daemon (runs as root)" ;;
          "background tasks") label="Background task ($who)" ;;
          developer) label="Developer identity with background items ($who)" ;;
          *) label="Background item: $btype ($who)" ;;
        esac
        name=${bid:-$burl}
        burl=${burl#file://}; [ "$burl" = "(null)" ] && burl=
        [ "$bexe" = "(null)" ] && bexe=
        [ -n "$burl" ] && [ -n "$bexe" ] && [ "$burl" != "$bexe" ] && d+=("item     $(uid_path "$burl")")
        prog=$(uid_path "${bexe:-$burl}"); [ "${prog#/}" = "$prog" ] && prog= ;;
      shell)  label="Shell or SSH startup file" ;;
      system)
        case "$f2" in
          "$SELF"|"$CONFIG")             label="backup-gate itself"; [ "$st" = CHANGED ] && d+=("note     expected after upgrading or editing backup-gate") ;;
          /Library/PrivilegedHelperTools/*) label="Privileged helper (runs as root)"; prog=$f2 ;;
          /etc/sudoers*|/etc/pam.d/*)    label="sudo or login rule" ;;
          /etc/hosts)                    label="hosts file (name resolution)" ;;
          /Library/Extensions/*)         label="Kernel extension" ;;
          /Library/Security/SecurityAgentPlugins/*) label="Login plugin" ;;
          /Library/ScriptingAdditions/*) label="Scripting addition" ;;
          /etc/crontab|/var/at/*|/etc/periodic/*) label="Scheduled job" ;;
          /etc/ssh/*)                    label="SSH server setting" ;;
          *)                             label="System startup file" ;;
        esac
        # entries listed from a folder have "owner:group:mode hash", single files just a hash
        if [ -n "$f4" ]; then [ -n "$new" ] && d+=("owner    ${f3//:/ }"); else o4=$o3; f4=$f3; o3=; f3=; fi ;;
      hook)   label="Login or logout hook"; d+=("command  ${o3:+$o3 -> }$f3") ;;
      cmd)    case "$f2" in profiles) label="Configuration profiles" ;; sysext) label="System extensions" ;; *) label=$f2 ;; esac
              name=$f3 ;;
      error)  label="Inventory error"; name="$f2 $f3" ;;
      *)      label=$kind ;;
    esac
    if [ "$st" = CHANGED ] && [ "$kind" != hook ]; then
      [ "$kind" = shell ] && { o4=$o3; f4=$f3; o3=; f3=; }
      [ -n "$o3" ] && [ "$o3" != "$f3" ] && d+=("change   permissions ${o3//:/ } -> ${f3//:/ }")
      if [ "$o4" != "$f4" ]; then
        case "$o4/$f4" in ABSENT/*) d+=("change   created") ;; */ABSENT) d+=("change   deleted") ;; *) d+=("change   contents changed") ;; esac
      fi
    fi
    if [ "$mode" = compact ]; then printf '  * '
    else case "$st" in ADDED) printf '%s+ ADDED  %s ' "$g" "$x" ;; REMOVED) printf '%s- REMOVED%s ' "$r" "$x" ;; *) printf '%s~ CHANGED%s ' "$y" "$x" ;; esac; fi
    printf '%s%s%s: %s\n' "$b" "$label" "$x" "$name"
    [ "$mode" = brief ] && continue
    if [ "$mode" = full ] && [ "${#d[@]}" -gt 0 ]; then for l in "${d[@]}"; do printf '           %s\n' "$l"; done; fi
    [ -n "$note" ] && printf '           %s\n' "$note"
    if [ -n "$prog" ] && [ "$st" != REMOVED ]; then
      sig=$(signer "$prog")
      if [ "$mode" = full ] && [ -n "$args" ]; then l=$args; else l=$(quote "$prog"); fi
      printf '           runs     %s\n' "$(clean "$l")"
      printf '                    %s\n' "$sig"
      risks "$prog" "$sig" | while IFS= read -r l; do printf '           %s%s%s\n' "$r" "$l" "$x"; done
    fi
  done < <(changes "$1" "$2")
  [ "$hidden" -gt 0 ] && echo "(Also watched, but they don't exist yet: $hidden files, hooks and settings.)"
  return 0
}

count_changes() { changes "$1" "$2" | wc -l | tr -d ' '; }

since() { [ -f "$ALLOW" ] && date -r "$(stat -f %m "$ALLOW")" '+%Y-%m-%d %H:%M'; }

approve() {
  need_root approve
  [ -t 0 ] || die "approve needs an interactive Terminal"
  refresh
  if [ -s "$STATE/flags" ]; then
    echo "These problems block backups and can't be approved:"
    local l; while IFS= read -r l; do printf '  %s\n' "$(clean "$l")"; done < "$STATE/flags"
    die "remove the item or fix the gate first."
  fi
  if [ -f "$ALLOW" ]; then
    if diff "$ALLOW" "$STATE/current" > "$STATE/pending.diff"; then echo "No changes since the last approval."; exit 0; fi
    echo "$(count_changes "$ALLOW" "$STATE/current") change(s) since the last approval ($(since))."
    echo "macOS doesn't record who creates these items: check when each one was created and what it runs."
    echo
    describe "$ALLOW" "$STATE/current" full
    echo
    echo "Approve only if every change is something you (or an update you ran) did."
  else
    echo "First approval. These are the programs and settings that start automatically on this Mac."
    echo "Everything listed will be trusted from now on: approve only if you recognize it."
    echo
    describe /dev/null "$STATE/current" compact
  fi
  while :; do
    printf '\nType APPROVE to accept, RAW for the raw diff, or press Return to cancel: '
    read -r ans
    case "$ans" in
      APPROVE) break ;;
      RAW|raw) if [ -f "$ALLOW" ]; then diff "$ALLOW" "$STATE/current" | while IFS= read -r l; do clean "$l"; echo; done
               else while IFS= read -r l; do clean "$l"; echo; done < "$STATE/current"; fi ;;
      *) die "not approved, nothing changed" ;;
    esac
  done
  mkdir -p "$ETC/history"
  [ -f "$ALLOW" ] && cp -p "$ALLOW" "$ETC/history/allowlist.$(date +%Y%m%d-%H%M%S)"
  install -o root -g wheel -m 644 "$STATE/current" "$ALLOW"
  rm -f "$STATE/pending.diff"
  log "approved by ${SUDO_USER:-root}"
  echo "Approved. To back up now: sudo /usr/local/sbin/backup-gate run now"
}

status() {
  local last
  last=$(cat "$STATE/last-success" 2>/dev/null)
  echo "Last successful backup: $([ -n "$last" ] && date -r "$last" '+%Y-%m-%d %H:%M' || echo never)"
  echo "Recent log:"; tail -n 5 "$LOG" 2>/dev/null | sed 's/^/  /'
  [ -s "$STATE/flags" ] && { echo "PROBLEMS (block backups):"; sed 's/^/  /' "$STATE/flags"; }
  if [ -f "$ALLOW" ] && [ -f "$STATE/current" ] && ! cmp -s "$ALLOW" "$STATE/current"; then
    echo "Changes waiting for approval (as of the last check):"
    describe "$ALLOW" "$STATE/current" brief | sed 's/^/  /'
    echo "Details, signers and approval: sudo $SELF approve"
  fi
  return 0
}

case "${1:-}" in
  run) run "${2:-}" ;;
  approve) approve ;;
  inventory) need_root inventory; refresh; echo "$(wc -l < "$STATE/current" | tr -d ' ') lines in $STATE/current"; cat "$STATE/flags" ;;
  status) status ;;
  version|--version) echo "backup-gate $VERSION" ;;
  *) echo "usage: backup-gate run [now] | approve | inventory | status | version" >&2; exit 64 ;;
esac
